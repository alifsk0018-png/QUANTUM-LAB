# Optional LLM API Configuration (keep secrets in .env, never commit .env)
# Supported providers: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
# Optional custom endpoint override (defaults automatically per AI_PROVIDER if left blank)
AI_API_URL=

# Database (SQLite by default; switch to PostgreSQL URL when migrating)
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/quantum_lab
DATABASE_URL=sqlite:///./quantum_lab.db

# CORS Allowed Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Simulation & Reliability Guardrails
MAX_QUBITS=8
MAX_SHOTS=10000
RATE_LIMIT_PER_MIN=120
MAX_REQUEST_BODY_BYTES=2097152
